
datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL_POOLED")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

model Project {
  id           String        @id @default(cuid())
  title        String
  description  String
  imageUrl     String?
  details      String[]
  status       String
  startDate    DateTime
  peopleHelped Int           @default(0)
  donations    Donation[]
  category     Category?     @relation(fields: [categoryId], references: [id])
  categoryId   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  projects  Project[]
  donations Donation[]
}

model Volunteer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  signupDate   DateTime @default(now())
  skills       String
  interests    String[]
  availability String[]
  status       String   @default("Pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Donation {
  id          String   @id @default(cuid())
  donorName   String
  email       String
  amount      Float
  date        DateTime @default(now())
  type        String
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String
  joinDate  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id String @id @default(cuid())
  appName String?
  logo String?
  logoType String? @default("icon")
  volunteerIcon String?

  heroTitle String?
  heroDescription String?
  heroImage String?

  missionIntroTitle String?
  missionIntroDescription String?
  missionImage String?
  
  missionTitle String?
  missionDescription String?
  visionTitle String?
  visionDescription String?
  valuesTitle String?
  valuesDescription String?

  volunteerIntroTitle String?
  volunteerIntroDescription1 String?
  volunteerIntroDescription2 String?

  socialLinksTwitter String?
  socialLinksFacebook String?
  socialLinksInstagram String?
  socialLinksYoutube String?
  socialLinksTelegram String?
  socialLinksWhatsApp String?
  socialLinksEmail String?
  socialLinksLinkedin String?
  socialLinksTikTok String?
}
