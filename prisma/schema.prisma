
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Project {
  id           String    @id @default(cuid())
  title        String
  description  String
  imageUrl     String?
  details      String // Stored as a newline-separated string
  status       String
  startDate    DateTime
  peopleHelped Int       @default(0)
  donations    Donation[]
  category     Category? @relation(fields: [categoryId], references: [id])
  categoryId   String?
}

model Volunteer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  signupDate   DateTime @default(now())
  skills       String
  interests    String // Stored as a comma-separated string
  availability String // Stored as a comma-separated string
  status       String   @default("Pending")
}

model Donation {
  id        String   @id @default(cuid())
  donorName String
  email     String
  amount    Float
  date      DateTime @default(now())
  type      String
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
  category  Category? @relation(fields: [categoryId], references: [id])
  categoryId String?
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     String   @default("ADMIN")
  joinDate DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
  donations Donation[]
}

model Settings {
  id                         String  @id @default(cuid())
  appName                    String?
  logo                       String?
  logoType                   String?
  volunteerIcon              String?
  heroTitle                  String?
  heroDescription            String?
  heroImages                 String? // Stored as a comma-separated string
  missionIntroTitle          String?
  missionIntroDescription    String?
  missionImage               String?
  missionTitle               String?
  missionDescription         String?
  visionTitle                String?
  visionDescription          String?
  valuesTitle                String?
  valuesDescription          String?
  volunteerIntroTitle        String?
  volunteerIntroDescription1 String?
  volunteerIntroDescription2 String?
  socialLinksTwitter         String?
  socialLinksFacebook        String?
  socialLinksInstagram       String?
}
