
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

model Project {
  id           String          @id @default(cuid())
  title        String
  description  String
  imageId      String
  details      String[]
  status       ProjectStatus   @default(PLANNING)
  startDate    DateTime        @default(now())
  peopleHelped Int             @default(0)
  category     ProjectCategory
  donations    Donation[]
}

model Volunteer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  signupDate   DateTime @default(now())
  skills       String
  interests    String[]
  availability String[]
  status       VolunteerStatus @default(PENDING)
}

model Donation {
  id        String       @id @default(cuid())
  donorName String
  email     String
  amount    Float
  date      DateTime     @default(now())
  type      DonationType
  project   Project?     @relation(fields: [projectId], references: [id])
  projectId String?
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     Role     @default(ADMIN)
  joinDate DateTime @default(now())
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

enum ProjectCategory {
  WATER
  EDUCATION
  MEDICAL
  COMMUNITY_DEVELOPMENT
  DISASTER_RELIEF
}

enum VolunteerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DonationType {
  ONE_TIME
  MONTHLY
}

enum Role {
  ADMIN
}
