
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id           String    @id @default(cuid())
  title        String
  description  String    @db.Text
  imageUrl     String?   @db.Text
  details      String[]
  status       String    @default("Planning")
  startDate    DateTime
  peopleHelped Int       @default(0)
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  donations    Donation[]
}

model Volunteer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  signupDate   DateTime @default(now())
  skills       String   @db.Text
  interests    String[]
  availability String[]
  status       String   @default("Pending")
}

model Donation {
  id          String   @id @default(cuid())
  donorName   String
  email       String
  amount      Float
  date        DateTime @default(now())
  type        String
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  joinDate  DateTime @default(now())
}

model Settings {
  id                         String  @id @default(cuid())
  appName                    String
  logo                       String?
  logoType                   String?
  volunteerIcon              String?
  heroTitle                  String?
  heroDescription            String?
  heroImage                  String? @db.Text
  missionIntroTitle          String?
  missionIntroDescription    String? @db.Text
  missionImage               String? @db.Text
  missionTitle               String?
  missionDescription         String? @db.Text
  visionTitle                String?
  visionDescription          String? @db.Text
  valuesTitle                String?
  valuesDescription          String? @db.Text
  volunteerIntroTitle        String?
  volunteerIntroDescription1 String? @db.Text
  volunteerIntroDescription2 String? @db.Text
  socialLinksTwitter         String?
  socialLinksFacebook        String?
  socialLinksInstagram       String?
}

model Category {
  id        String @id @default(cuid())
  name      String @unique
  projects  Project[]
  Donation  Donation[]
}
