// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  imageId     String
  details     String[]
  status      String   // Using String for simplicity, can be an Enum
  startDate   DateTime
  peopleHelped Int
  category    String
  donations   Donation[]
}

model Volunteer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  signupDate   DateTime
  skills       String   @db.Text
  interests    String[]
  availability String[]
  status       String   // Using String for simplicity, can be an Enum
}

model Donation {
  id        String   @id @default(cuid())
  donorName String
  email     String
  amount    Float
  date      DateTime
  type      String   // Using String for simplicity, can be an Enum (ONE_TIME, MONTHLY)
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   // e.g., 'ADMIN'
  joinDate  DateTime
}
