// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
}


model Project {
  id           String    @id @default(cuid())
  title        String
  description  String    @db.Text
  imageUrl     String?   @db.Text
  details      Json      @default("[]")
  status       String
  startDate    DateTime
  peopleHelped Int       @default(0)
  donations    Donation[]
  category     Category? @relation(fields: [categoryId], references: [id])
  categoryId   String?
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
  donations Donation[]
}

model Volunteer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  signupDate   DateTime @default(now())
  skills       String   @db.Text
  interests    Json     @default("[]")
  availability Json     @default("[]")
  status       String
}

model Donation {
  id          String   @id @default(cuid())
  donorName   String
  email       String
  amount      Float
  date        DateTime @default(now())
  type        String
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     String
  joinDate DateTime @default(now())
}

model Settings {
  id                        String  @id @default(cuid())
  appName                   String?
  logo                      String? @db.Text
  logoType                  String?
  volunteerIcon             String?
  heroTitle                 String?   @db.Text
  heroDescription           String?   @db.Text
  heroImage                 String?   @db.LongText
  heroImage1                String?   @db.LongText
  heroImage2                String?   @db.LongText
  heroImage3                String?   @db.LongText
  heroImage4                String?   @db.LongText
  missionIntroTitle         String?   @db.Text
  missionIntroDescription   String?   @db.Text
  missionImage              String?   @db.LongText
  missionTitle              String?   @db.Text
  missionDescription        String?   @db.Text
  visionTitle               String?   @db.Text
  visionDescription         String?   @db.Text
  valuesTitle               String?   @db.Text
  valuesDescription         String?   @db.Text
  volunteerIntroTitle       String?   @db.Text
  volunteerIntroDescription1 String?  @db.Text
  volunteerIntroDescription2 String?  @db.Text
  socialLinksTwitter        String?
  socialLinksFacebook       String?
  socialLinksInstagram      String?
  socialLinksYoutube        String?
  socialLinksTelegram       String?
  socialLinksWhatsApp       String?
  socialLinksEmail          String?
  socialLinksLinkedin       String?
  socialLinksTikTok         String?
}
