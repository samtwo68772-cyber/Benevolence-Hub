generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL_POOLED")
  directUrl = env("DATABASE_URL")
}

model Project {
  id           String        @id @default(cuid())
  title        String
  description  String        @db.Text
  imageUrl     String?       @db.Text
  details      String[]
  status       String
  startDate    DateTime
  peopleHelped Int
  donations    Donation[]
  category     Category?     @relation(fields: [categoryId], references: [id])
  categoryId   String?
}

model Volunteer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  signupDate   DateTime
  skills       String   @db.Text
  interests    String[]
  availability String[]
  status       String
}

model Donation {
  id         String       @id @default(cuid())
  donorName  String
  email      String
  amount     Float
  date       DateTime
  type       String
  project    Project?     @relation(fields: [projectId], references: [id])
  projectId  String?
  category   Category?    @relation(fields: [categoryId], references: [id])
  categoryId String?
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     String
  joinDate DateTime @default(now())
}

model Settings {
  id                        String  @id @default(cuid())
  appName                   String?
  logo                      String? @db.Text
  logoType                  String?
  volunteerIcon             String?
  heroTitle                 String?
  heroDescription           String? @db.Text
  heroImage                 String? @db.Text
  missionIntroTitle         String?
  missionIntroDescription   String? @db.Text
  missionImage              String? @db.Text
  missionTitle              String?
  missionDescription        String? @db.Text
  visionTitle               String?
  visionDescription         String? @db.Text
  valuesTitle               String?
  valuesDescription         String? @db.Text
  volunteerIntroTitle       String?
  volunteerIntroDescription1 String? @db.Text
  volunteerIntroDescription2 String? @db.Text
  socialLinksTwitter        String?
  socialLinksFacebook       String?
  socialLinksInstagram      String?
}


model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  projects  Project[]
  donations Donation[]
}
