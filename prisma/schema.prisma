
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id           String        @id @default(cuid())
  title        String
  description  String        @db.Text
  imageUrl     String?
  details      String[]
  status       String // Active, Completed, Planning
  startDate    DateTime
  peopleHelped Int
  category     Category?     @relation(fields: [categoryId], references: [id])
  categoryId   String?
  donations    Donation[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
  donations Donation[]
}

model Volunteer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  signupDate   DateTime @default(now())
  skills       String   @db.Text
  interests    String[]
  availability String[]
  status       String // Pending, Approved, Rejected
}

model Donation {
  id        String   @id @default(cuid())
  donorName String
  email     String
  amount    Float
  date      DateTime @default(now())
  type      String // ONE_TIME, MONTHLY
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     String // ADMIN
  joinDate DateTime @default(now())
}

model Settings {
  id                      String    @id @default(cuid())
  appName                 String?
  logo                    String?
  logoType                String?
  volunteerIcon           String?
  heroTitle               String?
  heroDescription         String?
  heroImages              String[]
  missionIntroTitle       String?
  missionIntroDescription String?
  missionImage            String?
  missionTitle            String?
  missionDescription      String?
  visionTitle             String?
  visionDescription       String?
  valuesTitle             String?
  valuesDescription       String?
  volunteerIntroTitle     String?
  volunteerIntroDescription1 String?
  volunteerIntroDescription2 String?
  socialLinksTwitter      String?
  socialLinksFacebook     String?
  socialLinksInstagram    String?
}
