// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id           String    @id @default(cuid())
  title        String
  description  String
  imageId      String
  details      String[]
  status       ProjectStatus
  startDate    DateTime
  peopleHelped Int
  category     ProjectCategory
  donations    Donation[]
}

model Volunteer {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  phone        String?
  signupDate   DateTime        @default(now())
  skills       String
  interests    String[]
  availability String[]
  status       VolunteerStatus @default(Pending)
}

model Donation {
  id        String      @id @default(cuid())
  donorName String
  email     String
  amount    Float
  date      DateTime    @default(now())
  type      DonationType
  project   Project?    @relation(fields: [projectId], references: [id])
  projectId String?
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     UserRole
  joinDate DateTime @default(now())
}

enum ProjectStatus {
  Planning
  Active
  Completed
}

enum ProjectCategory {
  Water
  Education
  Medical
  Community
  DisasterRelief
}

enum VolunteerStatus {
  Pending
  Approved
  Rejected
}

enum DonationType {
  ONE_TIME
  MONTHLY
}

enum UserRole {
  ADMIN
  USER
}
