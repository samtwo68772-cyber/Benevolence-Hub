
datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Project {
  id           String    @id @default(cuid())
  title        String
  description  String
  imageUrl     String?
  details      String[]
  status       String    @default("Planning")
  startDate    DateTime
  peopleHelped Int       @default(0)
  donations    Donation[]
  category     Category?  @relation(fields: [categoryId], references: [id])
  categoryId   String?
}

model Volunteer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  signupDate   DateTime @default(now())
  skills       String
  interests    String[]
  availability String[]
  status       String   @default("Pending")
}

model Donation {
  id          String   @id @default(cuid())
  donorName   String
  email       String
  amount      Float
  date        DateTime @default(now())
  type        String
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  String?
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     String   @default("ADMIN")
  joinDate DateTime @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  projects  Project[]
  donations Donation[]
}

model Settings {
  id                         String   @id @default(cuid())
  appName                    String   @default("Benevolence Hub")
  logo                       String?
  logoType                   String?  @default("icon")
  volunteerIcon              String?  @default("HeartHandshake")
  heroTitle                  String?
  heroDescription            String?
  heroImage                  String?
  missionIntroTitle          String?
  missionIntroDescription    String?
  missionImage               String?
  missionTitle               String?
  missionDescription         String?
  visionTitle                String?
  visionDescription          String?
  valuesTitle                String?
  valuesDescription          String?
  volunteerIntroTitle        String?
  volunteerIntroDescription1 String?
  volunteerIntroDescription2 String?
  socialLinksTwitter         String?
  socialLinksFacebook        String?
  socialLinksInstagram       String?
  socialLinksYoutube         String?
  socialLinksTelegram        String?
  socialLinksWhatsApp        String?
  socialLinksEmail           String?
  socialLinksLinkedin        String?
  socialLinksTikTok          String?
}
