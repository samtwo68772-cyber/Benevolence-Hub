// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id           String    @id @default(cuid())
  title        String
  description  String    @db.Text
  imageId      String
  details      String[]
  status       String // "Active", "Completed", "Planning"
  startDate    DateTime
  peopleHelped Int
  category     String // "Water", "Education", "Medical", "General Aid", "Shelter"
  donations    Donation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Volunteer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  signupDate   DateTime
  skills       String   @db.Text
  interests    String[]
  availability String[]
  status       String // "Pending", "Approved", "Rejected"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Donation {
  id        String  @id @default(cuid())
  donorName String
  email     String
  amount    Float
  date      DateTime
  type      String // "One-time", "Monthly"
  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String  @id @default(cuid())
  name      String?
  email     String? @unique
  password  String
  
  admin     Admin?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  role      String   @default("Admin")
  joinDate  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
