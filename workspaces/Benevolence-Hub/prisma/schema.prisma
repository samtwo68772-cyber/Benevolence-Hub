
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id           String    @id @default(cuid())
  title        String
  description  String    @db.Text
  imageUrl     String?   @db.Text
  details      String[]
  status       String
  startDate    DateTime
  peopleHelped Int       @default(0)
  category     Category? @relation(fields: [categoryId], references: [id])
  categoryId   String?
  donations    Donation[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
  donations Donation[]
}

model Volunteer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  signupDate   DateTime @default(now())
  skills       String   @db.Text
  interests    String[]
  availability String[]
  status       String
}

model Donation {
  id         String   @id @default(cuid())
  donorName  String
  email      String
  amount     Float
  date       DateTime @default(now())
  type       String
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String
  joinDate  DateTime @default(now())
}

model Settings {
  id                         String   @id @default(cuid())
  appName                    String?
  logo                       String?  @db.Text
  logoType                   String?
  volunteerIcon              String?
  heroTitle                  String?
  heroDescription            String?  @db.Text
  heroImage                  String?  @db.Text
  missionIntroTitle          String?
  missionIntroDescription    String?  @db.Text
  missionImage               String?  @db.Text
  missionTitle               String?
  missionDescription         String?  @db.Text
  visionTitle                String?
  visionDescription          String?  @db.Text
  valuesTitle                String?
  valuesDescription          String?  @db.Text
  volunteerIntroTitle        String?
  volunteerIntroDescription1 String?  @db.Text
  volunteerIntroDescription2 String?  @db.Text
  socialLinksTwitter         String?
  socialLinksFacebook        String?
  socialLinksInstagram       String?
}
